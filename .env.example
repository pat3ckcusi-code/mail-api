# Copy to .env and fill in. Never commit the real .env.

PORT=3000

# Mailcow's Dovecot IMAP - published directly on the host by docker-compose.yml
# (IMAPS_PORT there, default 993).
IMAP_HOST=mail.lgucalapan.ph
IMAP_PORT=993
IMAP_SECURE=true

# Mailcow's Postfix submission port (SUBMISSION_PORT in docker-compose.yml,
# default 587, STARTTLS - not implicit TLS, so SMTP_SECURE stays false).
SMTP_HOST=mail.lgucalapan.ph
SMTP_PORT=587
SMTP_SECURE=false

# Generate both with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# JWT_SECRET signs the session token; CRED_ENC_KEY encrypts the IMAP password
# stored inside it. Keep them different so a JWT_SECRET leak alone can't
# decrypt stored credentials.
JWT_SECRET=
CRED_ENC_KEY=
JWT_EXPIRES_IN=30d
